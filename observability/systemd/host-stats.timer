# Install to /etc/systemd/system/host-stats.timer, then: systemctl enable --now host-stats.timer
# One sample a minute — ~1,440 short lines a day, a rounding error in Loki.
[Unit]
Description=Log host vitals every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
