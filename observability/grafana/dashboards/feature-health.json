    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "The endpoints these features depend on",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "description": "Request rate for the APIs behind lessons, planners and telemetry.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "axisSoftMin": 0
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "expr": "sum(count_over_time({job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | uri =~ \"/api/progress.*\" [$__auto]))",
          "legendFormat": "/api/progress"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "expr": "sum(count_over_time({job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | uri =~ \"/api/plan.*\" [$__auto]))",
          "legendFormat": "/api/plan"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "expr": "sum(count_over_time({job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | uri =~ \"/api/events.*\" [$__auto]))",
          "legendFormat": "/api/events"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "…and how slow they are (p95)",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "description": "If a completion rate fell at the same time one of these rose, that is the investigation: product symptom, technical cause.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "axisSoftMin": 0
          },
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | __error__=\"\" | uri =~ \"/api/progress.*\" | unwrap duration [$__auto]) by (site)",
          "legendFormat": "/api/progress"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | __error__=\"\" | uri =~ \"/api/plan.*\" | unwrap duration [$__auto]) by (site)",
          "legendFormat": "/api/plan"
        }
      ]
