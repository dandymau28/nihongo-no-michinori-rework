{
  "uid": "michinori-logs",
  "title": "Logs & traffic",
  "description": "What the server did: nginx requests, app logs from the systemd journal, errors.",
  "tags": [
    "michinori"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"nginx\", stream=\"access\", site=\"michinori\"} [$__range]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed (5xx)",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | status >= 500 [$__range]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Not found / rejected (4xx)",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | status >= 400 | status < 500 [$__range]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Response time (p95)",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "instant",
          "expr": "quantile_over_time(0.95, {job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | __error__=\"\" | unwrap duration [$__range]) by (site)"
        }
      ],
      "description": "95 out of 100 requests finished faster than this."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests over time",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed (5xx)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rejected (4xx)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "legendFormat": "ok",
          "expr": "sum(count_over_time({job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | status < 400 [$__auto]))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "legendFormat": "rejected (4xx)",
          "expr": "sum(count_over_time({job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | status >= 400 | status < 500 [$__auto]))"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "legendFormat": "failed (5xx)",
          "expr": "sum(count_over_time({job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | status >= 500 [$__auto]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Response time",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "axisSoftMin": 0
          },
          "unit": "s",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p90"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "legendFormat": "p90",
          "expr": "quantile_over_time(0.90, {job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | __error__=\"\" | unwrap duration [$__auto]) by (site)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "legendFormat": "p95",
          "expr": "quantile_over_time(0.95, {job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | __error__=\"\" | unwrap duration [$__auto]) by (site)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "legendFormat": "p99",
          "expr": "quantile_over_time(0.99, {job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | __error__=\"\" | unwrap duration [$__auto]) by (site)"
        }
      ],
      "description": "p90, p95 and p99 of nginx request time. The gap between them is the shape of the tail: close together means consistent, p99 far above p95 means a few requests are much slower than the rest."
    },
    {
      "id": 7,
      "type": "logs",
      "title": "App log",
      "description": "Everything the Next.js service printed — both release slots.",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "maxLines": 500,
          "expr": "{job=\"journal\", unit=~\"nihongo-no-michinori.*\"}"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Errors anywhere on the server",
      "description": "The app, PostgreSQL, nginx, certbot, sshd — anything the journal marked as an error or said \"error\".",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "maxLines": 500,
          "expr": "{job=\"journal\"} |~ \"(?i)(error|fatal|panic|unhandled|refused)\""
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Most requested pages",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "instant",
          "format": "table",
          "expr": "topk(20, sum by (uri) (count_over_time({job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | __error__=\"\" [$__range])))"
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Failed requests (5xx)",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "maxLines": 200,
          "expr": "{job=\"nginx\", stream=\"access\", site=\"michinori\"} | json | status >= 500"
        }
      ],
      "description": "The site only — Grafana's own errors on horus are excluded."
    }
  ]
}
