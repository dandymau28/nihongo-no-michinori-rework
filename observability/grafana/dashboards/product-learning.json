    {
      "id": 9,
      "type": "timeseries",
      "title": "Accuracy",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "description": "Share of answered questions that were right. A sudden fall usually means a content problem, not a learner problem.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "axisSoftMin": 0,
            "axisSoftMax": 1
          },
          "unit": "percentunit",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "range",
          "expr": "sum(count_over_time({job=\"journal\", unit=~\"nihongo-no-michinori.*\"} |= \"\\\"evt\\\":\" | json | evt=\"question.answered\" | props_correct=\"true\" [$__auto])) / sum(count_over_time({job=\"journal\", unit=~\"nihongo-no-michinori.*\"} |= \"\\\"evt\\\":\" | json | evt=\"question.answered\" [$__auto]))",
          "legendFormat": "accuracy"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
