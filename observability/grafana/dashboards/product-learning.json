{
  "uid": "michinori-product",
  "title": "Product & learning",
  "description": "What learners actually do, guests included. Built from the app's own events; the numbers cover the dashboard's time range unless a panel says otherwise.",
  "tags": [
    "michinori",
    "product"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active learners (24h)",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "instant",
          "expr": "count(sum by (anonId) (count_over_time({job=\"journal\", unit=~\"nihongo-no-michinori.*\"} |= \"\\\"evt\\\":\" | json | anonId != \"\" [24h])))"
        }
      ]
    },
