{
  "uid": "michinori-usage",
  "title": "Site usage",
  "description": "Who is learning: accounts, planners and lessons finished. Reads the metrics schema only.",
  "tags": ["michinori"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Learners",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "text" }, "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select learners from metrics.totals"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Confirmed email",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "text" }, "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select confirmed_email from metrics.totals"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Planners",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "text" }, "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select planners from metrics.totals"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Studied in the last 7 days",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select active_7d from metrics.totals"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Lessons finished (all time)",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select lessons_done from metrics.totals"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "New accounts per day",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barAlignment": 0,
            "axisSoftMin": 0
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select day as time, signups as \"sign-ups\", confirmed as \"confirmed email\" from metrics.signups_daily where $__timeFilter(day) order by 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Lessons finished per day",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barAlignment": 0,
            "axisSoftMin": 0
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select day as time, lessons_done as \"lessons finished\", active_learners as \"learners studying\" from metrics.activity_daily where $__timeFilter(day) order by 1"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Sign-ins per day",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "axisSoftMin": 0 },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select day as time, signins as \"sign-ins\", learners from metrics.signins_daily where $__timeFilter(day) order by 1"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Planners by preset",
      "description": "Which presets learners pick, and how many lessons and custom tasks those planners hold.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select planner, planners, avg_lessons as \"avg lessons\", avg_custom_tasks as \"avg tasks\", last_started as \"last started\" from metrics.planners_by_preset order by planners desc"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Lessons learners never finish",
      "description": "In planners, but still untouched. The top rows are where learners stall — a good queue for content work.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 19 },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select lesson_id as lesson, in_planners as \"in planners\", done, untouched, skipped from metrics.lesson_dropoff order by untouched desc, in_planners desc limit 25"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Most finished lessons",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
      "gridPos": { "h": 9, "w": 6, "x": 12, "y": 19 },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select lesson_id as lesson, done, in_progress as \"in progress\" from metrics.lesson_status order by done desc, learners desc limit 25"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Practice trainers",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 19 },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "michinori-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select trainer, learners, last_used as \"last used\" from metrics.practice_usage order by learners desc"
        }
      ]
    }
  ]
}
