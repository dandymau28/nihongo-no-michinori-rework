{
  "uid": "michinori-funnel",
  "title": "Learning funnel",
  "description": "Where learners drop out. Steps count distinct learners (guests by anonId); conversions count events, so they survive a learner repeating a step.",
  "tags": [
    "michinori",
    "product"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Lesson funnel — learners reaching each step",
      "datasource": {
        "type": "loki",
        "uid": "michinori-loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlPu"
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "instant",
          "expr": "count(sum by (anonId) (count_over_time({unit=~\"nihongo-no-michinori.*\"} |= \"\\\"evt\\\":\" | json | evt=\"lesson.viewed\" | anonId != \"\" [$__range])))",
          "legendFormat": "1 · opened a lesson"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "instant",
          "expr": "count(sum by (anonId) (count_over_time({unit=~\"nihongo-no-michinori.*\"} |= \"\\\"evt\\\":\" | json | evt=\"lesson.started\" | anonId != \"\" [$__range])))",
          "legendFormat": "2 · started it"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "instant",
          "expr": "count(sum by (anonId) (count_over_time({unit=~\"nihongo-no-michinori.*\"} |= \"\\\"evt\\\":\" | json | evt=\"exercise.started\" | anonId != \"\" [$__range])))",
          "legendFormat": "3 · started an exercise"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "instant",
          "expr": "count(sum by (anonId) (count_over_time({unit=~\"nihongo-no-michinori.*\"} |= \"\\\"evt\\\":\" | json | evt=\"exercise.completed\" | anonId != \"\" [$__range])))",
          "legendFormat": "4 · finished an exercise"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "michinori-loki"
          },
          "queryType": "instant",
          "expr": "count(sum by (anonId) (count_over_time({unit=~\"nihongo-no-michinori.*\"} |= \"\\\"evt\\\":\" | json | evt=\"lesson.completed\" | anonId != \"\" [$__range])))",
          "legendFormat": "5 · finished the lesson"
