// Prisma schema — PostgreSQL.
// Auth tables (user/session/account/verification) follow better-auth's core schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (better-auth)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  sessions      Session[]
  accounts      Account[]
  planSettings  PlanSettings?
  planEntries   PlanEntry[]
  dayProgress   DayProgress[]
  practiceStats PracticeStats[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Personal planner
// ---------------------------------------------------------------------------

/// One per learner: how their plan is laid out on the calendar.
model PlanSettings {
  userId    String   @id
  /// ISO YYYY-MM-DD
  startDate String
  /// Weekday bitmask, bit 0 = Sunday … bit 6 = Saturday
  studyDays Int      @default(127)
  /// Lessons per study day when (re)building the schedule
  perDay    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("plan_settings")
}

/// A scheduled item: either a built-in lesson (`materialDay` = its day number in
/// the 90-day plan) or a learner-created custom task (`materialDay` null).
model PlanEntry {
  id          String   @id @default(cuid())
  userId      String
  materialDay Int?
  title       String?
  note        String?
  /// ISO YYYY-MM-DD
  date        String?
  skipped     Boolean  @default(false)
  /// Custom tasks only — lessons take their status from DayProgress
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, materialDay])
  @@index([userId, date])
  @@map("plan_entry")
}

// ---------------------------------------------------------------------------
// Progress
// ---------------------------------------------------------------------------

model DayProgress {
  userId    String
  /// Lesson day number (1..90)
  day       Int
  status    String   @default("not-yet")
  reviewed  Boolean  @default(false)
  notes     String   @default("")
  exercises Json     @default("[]")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("day_progress")
}

/// Free-practice trainer stats (conjugation, particles, kanji, question words).
model PracticeStats {
  userId    String
  key       String
  data      Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("practice_stats")
}
