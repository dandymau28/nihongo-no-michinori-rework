// Prisma schema — PostgreSQL.
// Auth tables (user/session/account/verification) follow better-auth's core schema.
// Database naming is snake_case throughout (tables via @@map, columns via @map);
// the generated client keeps camelCase field names.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (better-auth)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  sessions       Session[]
  accounts       Account[]
  planSettings   PlanSettings?
  planEntries    PlanEntry[]
  lessonProgress LessonProgress[]
  dayProgress    DayProgress[]
  practiceStats  PracticeStats[]
  kanjiDecks     KanjiDeck[]
  kanjiDeckUses  KanjiDeckUse[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Planner (one per learner)
// ---------------------------------------------------------------------------

/// The learner's planner: where it came from and how it's laid out on the calendar.
model PlanSettings {
  userId    String   @id @map("user_id")
  /// Custom name; null = the preset's title (or "My planner" for a custom planner)
  name      String?
  /// Preset it was started from (src/data/presets.ts); null = built from scratch
  presetId  String?  @map("preset_id")
  /// ISO YYYY-MM-DD
  startDate String   @map("start_date")
  /// Weekday bitmask, bit 0 = Sunday … bit 6 = Saturday
  studyDays Int      @default(127) @map("study_days")
  /// Lessons per study day when laying lessons out
  perDay    Int      @default(1) @map("per_day")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("plan_settings")
}

/// A planner item: a catalog lesson (`lessonId`) or a learner-created custom task (`lessonId` null).
model PlanEntry {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  /// Lesson id from src/data/lessons.ts; null for a custom task
  lessonId    String?  @map("lesson_id")
  /// The lesson's place in the learner's order (custom tasks: null)
  position    Int?
  /// LEGACY — the lesson's day in the old 90-day plan. Still written so the previous release
  /// works after a rollback; removed by a later migration.
  materialDay Int?     @map("material_day")
  title       String?
  note        String?
  /// ISO YYYY-MM-DD
  date        String?
  skipped     Boolean  @default(false)
  /// Custom tasks only — lessons take their status from LessonProgress
  done        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@unique([userId, materialDay])
  @@index([userId, date])
  @@index([userId, position])
  @@map("plan_entry")
}

// ---------------------------------------------------------------------------
// Progress
// ---------------------------------------------------------------------------

/// Progress on one lesson — shared by every planner and by taking the lesson on its own.
model LessonProgress {
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  status    String   @default("not-yet")
  reviewed  Boolean  @default(false)
  notes     String   @default("")
  exercises Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("lesson_progress")
}

/// LEGACY — progress by day number in the old 90-day plan. Still written for lessons that have
/// a legacy day so the previous release works after a rollback; removed by a later migration.
model DayProgress {
  userId    String   @map("user_id")
  /// Lesson day number (1..90)
  day       Int
  status    String   @default("not-yet")
  reviewed  Boolean  @default(false)
  notes     String   @default("")
  exercises Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("day_progress")
}

/// Free-practice trainer stats (conjugation, particles, kanji, question words).
model PracticeStats {
  userId    String   @map("user_id")
  key       String
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("practice_stats")
}

// ---------------------------------------------------------------------------
// Kanji flashcard decks (learner-built, shared by link)
// ---------------------------------------------------------------------------

/// A set of kanji a learner picked out of the catalog (src/data/kanji.ts) to drill.
/// Anyone signed in who has the link can study it; only the owner sees who has.
model KanjiDeck {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  title       String
  description String?
  /// The whole of the share URL, /d/<token>. Random, so the link is the permission;
  /// rotating it is how a learner takes a deck back out of circulation.
  shareToken  String  @unique @map("share_token")
  /// Opens of the share page by anyone but the owner, signed in or not, counted once
  /// per browser session. Deliberately separate from the unique-learner count below.
  visits      Int     @default(0)
  /// The deck this one was copied from. A plain id, not a relation: a copy outlives
  /// the original, and its use counts are its own.
  copiedFromId String? @map("copied_from_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards KanjiDeckCard[]
  uses  KanjiDeckUse[]

  @@index([userId, updatedAt])
  @@map("kanji_deck")
}

/// One kanji in a deck. The character is the key, so a deck can't hold it twice;
/// `position` is the order the owner arranged them in.
model KanjiDeckCard {
  deckId   String    @map("deck_id")
  char     String
  position Int
  deck     KanjiDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([deckId, char])
  @@index([deckId, position])
  @@map("kanji_deck_card")
}

/// One row per signed-in learner who has studied a deck — the unique-learner count and
/// the names its owner sees. Guests leave no row; they only add to `visits`.
model KanjiDeckUse {
  deckId      String   @map("deck_id")
  userId      String   @map("user_id")
  /// Separate sessions this learner opened it in.
  sessions    Int      @default(1)
  firstUsedAt DateTime @default(now()) @map("first_used_at")
  lastUsedAt  DateTime @default(now()) @map("last_used_at")

  deck KanjiDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([deckId, userId])
  @@index([deckId, lastUsedAt])
  @@map("kanji_deck_use")
}
