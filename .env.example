# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nihongo_no_michinori?schema=public"

# better-auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
# Public origin of the site (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional — the Google button is hidden when these are empty).
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Outgoing email (password reset links). Any SMTP provider works — Gmail with an
# app password, Brevo, Resend (smtp.resend.com), … While SMTP_HOST is empty,
# emails are printed to the server log instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Nihongo No Michinori <support@example.com>"
# Where replies go (a real inbox). Empty = replies go to EMAIL_FROM.
EMAIL_REPLY_TO=""
